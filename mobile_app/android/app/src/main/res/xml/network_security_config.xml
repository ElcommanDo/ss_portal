<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS everywhere. Plain HTTP is allowed ONLY for the raw server IP listed in ALLOWED_HOSTS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">145.241.111.52</domain>
    </domain-config>
</network-security-config>
